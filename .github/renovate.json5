{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices"],
  "rebaseWhen": "never",
  "packageRules": [
    {
      // A new Bazzite build: CI builds it on the PR, then it merges itself.
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/ublue-os/bazzite-gnome-nvidia-open"],
      "matchUpdateTypes": ["digest", "pinDigest"],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true
    },
    {
      // rpm-ostree only verifies cosign's old bundle format; never bump it unreviewed.
      "matchPackageNames": ["sigstore/cosign-installer"],
      "automerge": false
    }
  ]
}
